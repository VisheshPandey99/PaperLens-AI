datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String           @id @default(cuid())
  name                   String?
  email                  String           @unique
  emailVerified          DateTime?
  image                  String?
  passwordHash           String?
  plan                   String           @default("FREE") // "FREE" | "PREMIUM"
  analysisCount          Int              @default(0) // Lifetime starter analyses count (max 5 on FREE)
  subscriptionStatus     String           @default("INACTIVE") // "INACTIVE" | "ACTIVE" | "PAST_DUE" | "CANCELED"
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  accounts         Account[]
  sessions         Session[]
  analyses         Analysis[]
  comparisons      Comparison[]
  generatedPapers  GeneratedPaper[]
  savedPapers      SavedPaper[]
  subscriptions    Subscription[]
  usages           Usage[]
  loginHistories   LoginHistory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ResearchPaper {
  id              String       @id @default(cuid())
  openAlexId      String?      @unique
  title           String
  authors         String       // JSON stringified list of author names
  abstract        String
  year            Int?
  publicationDate String?
  doi             String?
  sourceUrl       String?
  sourceName      String?
  pdfUrl          String?
  type            String?
  institution     String?
  topics          String?      // JSON stringified topics
  externalId      String?
  venue           String?
  citationCount   Int?         @default(0)
  isOpenAccess    Boolean      @default(false)
  createdAt       DateTime     @default(now())

  analyses      Analysis[]
  savedIn       SavedPaper[]
}

model Institution {
  id          String   @id @default(cuid())
  openAlexId  String   @unique
  name        String
  countryCode String?
  type        String?
  ror         String?
  worksCount  Int?     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Analysis {
  id              String         @id @default(cuid())
  userId          String
  paperId         String?
  status          String         @default("COMPLETED") // "PENDING" | "PROCESSING" | "COMPLETED" | "FAILED"
  title           String         @default("Untitled Research Paper")
  authors         String         @default("[]")
  overview        String
  problem         String
  objectives      String
  methodology     String
  dataset         String
  results         String
  findings        String?
  limitations     String
  researchGap     String
  futureWork      String
  recommendation  String
  confidenceScore Int            @default(92)
  gapProminence   Int            @default(85)
  similarPapers   String         @default("[]") // JSON stringified similar papers
  createdAt       DateTime       @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper ResearchPaper? @relation(fields: [paperId], references: [id], onDelete: SetNull)
}

model Comparison {
  id           String   @id @default(cuid())
  userId       String
  title        String
  paperIds     String   // JSON stringified array of paper IDs or titles
  matrixData   String   // JSON stringified comparison matrix
  crossPaperGap String  // AI-identified cross-study gap synthesis
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GeneratedPaper {
  id            String   @id @default(cuid())
  userId        String
  prompt        String   // JSON stringified prompt inputs
  title         String
  abstract      String
  content       String   // JSON stringified structured 12 sections
  status        String   @default("DRAFT") // "DRAFT" | "FINALIZED"
  wordCount     Int      @default(0)
  citationStyle String   @default("APA")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedPaper {
  id        String        @id @default(cuid())
  userId    String
  paperId   String
  notes     String?
  tags      String?       // Comma-separated or JSON
  createdAt DateTime      @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  stripeSubscriptionId String    @unique
  stripePriceId        String
  status               String    // "ACTIVE" | "CANCELED" | "PAST_DUE"
  currentPeriodStart   DateTime  @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Usage {
  id                 String   @id @default(cuid())
  userId             String   @unique
  analysisCount      Int      @default(0)
  generatedPaperCount Int     @default(0)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
